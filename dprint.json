{
  "lineWidth": 100,
  "excludes": [".just/**", "CHANGELOG.md", "**/*.min.css", "**/*.min.js", "profiles/**/files/**"],
  "json": { "lineWidth": 160, "trailingCommas": "never", "object.preferSingleLine": true, "array.preferSingleLine": true },
  "includes": ["**/*.{json,jsonc,css,js,md,yml,yaml,py}"],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.29.0.wasm@714aea7555dd9831861be466da8b26b2d92316d3cde550ef3e1f63b31f4ea302",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    "https://plugins.dprint.dev/ruff-0.12.3.wasm@e0c714f9d36b8fa4297e86ba9f8b70feb2d90419e51a13d75ff3ce3e8d775464",
    "https://plugins.dprint.dev/json-0.26.0.wasm@9abcd6eb43b3d04655649090c2e7ad14948da6acfe0374cb47ccd9eb3c48903d",
    "https://plugins.dprint.dev/typescript-0.101.0.wasm@4401b6e344db92a5e661a05958267d4b3068fa82c89067e9e8ffe849798644f4",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.1.wasm@ea107342885e7a337b5da1ddf67101400e2621732556ec761f66d00208e74453"
  ],
  "markdown": { "lineWidth": 80, "textWrap": "always", "emphasisKind": "asterisks", "strongKind": "asterisks" },
