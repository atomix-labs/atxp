{
  "permissions": {
    "allow": [
      "Bash(just check*)",
      "Bash(just fix*)",
      "Bash(just --list)",
      "Bash(devset status*)",
      "Bash(devset diff*)",
      "Bash(devset explain*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)"
    ],
    "deny": ["Bash(just publish*)", "Bash(just bump*)"]
  },
  "hooks": {
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh", "timeout": 600 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh start" }] }]
  }
}
