{
  "permissions": {
    "allow": [
      "Bash(just check*)",
      "Bash(just fix*)",
      "Bash(just --list)",
      "Bash(devset status*)",
      "Bash(devset diff*)",
      "Bash(devset explain*)",
      "Bash(devset features*)"
    ],
    "deny": ["Bash(just publish*)", "Bash(just bump*)"]
  },
  "hooks": { "Stop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh", "timeout": 600 }] }] }
}
