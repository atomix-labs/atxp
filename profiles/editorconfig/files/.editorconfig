# https://editorconfig.org
root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 4
insert_final_newline     = true
trim_trailing_whitespace = true
max_line_length          = {{ line_width }}

[*.{json,jsonc,md,toml,yaml,yml}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
