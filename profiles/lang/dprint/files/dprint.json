{#- Each language profile's features, empty where it is not applied: dprint formats a language where its profile's `format` is on. -#}
{%- set md = devset.layers | selectattr("profile", "equalto", "markdown") | map(attribute="features") | first | default([]) -%}
{%- set yml = devset.layers | selectattr("profile", "equalto", "yaml") | map(attribute="features") | first | default([]) -%}
{%- set py = devset.layers | selectattr("profile", "equalto", "python") | map(attribute="features") | first | default([]) -%}
{
  "lineWidth": {{ line_width }},
  "excludes": [".just/**", "CHANGELOG.md", "**/*.min.css", "**/*.min.js"],
  "json": { "lineWidth": 160, "trailingCommas": "never", "object.preferSingleLine": true, "array.preferSingleLine": true },
  "includes": ["**/*.{json,jsonc,css,js{% if "format" in md %},md{% endif %}{% if "format" in yml %},yml,yaml{% endif %}{% if "format" in py %},py{% endif %}}"],
  "plugins": [
{%- if "format" in md %}
    "https://plugins.dprint.dev/markdown-0.28.0.wasm@96182f4bf9f91befb599b93183e873bd50782fad27cfd1b8b8851831aa3c0ff4",
{%- endif %}
{%- if "format" in yml %}
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
{%- endif %}
{%- if "format" in py %}
    "https://plugins.dprint.dev/ruff-0.11.2.wasm@451da30c12783e8cd562e1341c8591a72cacaefafc184ded1e170c0707234f3b",
{%- endif %}
    "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm@9c52244de2c25a33addc7ddacff4443234a2dc4b5d3f34131262d1e0df35007c",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm@1c1b31f972ef5aae052f97b6723aaf962e0175c5bbe4ba877e092512af354113"
  ]
}
