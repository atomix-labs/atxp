{%- set md = devset.layers | selectattr("profile", "equalto", "markdown") | map(attribute="features") | first | default([]) -%}
{%- set extensions = [
  ["rust-toolchain" in devset.profiles, "rust-lang.rust-analyzer"],
  ["toml" in devset.profiles, "tamasfe.even-better-toml"],
  ["dprint" in devset.profiles, "dprint.dprint"],
  ["lint" in md, "rvben.rumdl"],
  ["just" in devset.profiles, "nefrob.vscode-just-syntax"]
] -%}
{ "recommendations": [{% for on, extension in extensions if on %}"{{ extension }}"{% if not loop.last %}, {% endif %}{% endfor %}] }
