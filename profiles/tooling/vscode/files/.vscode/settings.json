{%- set md = devset.layers | selectattr("profile", "equalto", "markdown") | map(attribute="features") | first | default([]) -%}
{%- set yml = devset.layers | selectattr("profile", "equalto", "yaml") | map(attribute="features") | first | default([]) -%}
{%- set py = devset.layers | selectattr("profile", "equalto", "python") | map(attribute="features") | first | default([]) -%}
{%- set tml = devset.layers | selectattr("profile", "equalto", "toml") | map(attribute="features") | first | default([]) -%}
{
{%- if "rust-toolchain" in devset.profiles %}
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.invocationStrategy": "per_workspace",
  "rust-analyzer.cargo.extraEnv": { "CARGO_TARGET_DIR": "target/ra" },
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
{%- endif %}
{%- if "rust-clippy" in devset.profiles %}
  "rust-analyzer.check.command": "clippy",
{%- endif %}
{%- if "format" in tml %}
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
{%- endif %}
{%- if "lint" in md %}
  "rumdl.fixOnSave": true,
{%- endif %}
{%- if "markdown" in devset.profiles %}
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.markdownFragmentLinks": "ignore",
{%- endif %}
{%- if "dprint" in devset.profiles %}
  "json.schemaDownload.trustedDomains": { "https://plugins.dprint.dev/": true, "https://dprint.dev/": true },
  "[json][jsonc]{% if "format" in md %}[markdown]{% endif %}{% if "format" in yml %}[yaml]{% endif %}{% if "format" in py %}[python]{% endif %}[javascript][css]": { "editor.defaultFormatter": "dprint.dprint" },
{%- endif %}
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true
}
