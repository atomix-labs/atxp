{
{%- if "rust-toolchain" in devset.profiles %}
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.invocationStrategy": "per_workspace",
  "rust-analyzer.cargo.extraEnv": { "CARGO_TARGET_DIR": "target/ra" },
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
{%- endif %}
{%- if "rust-clippy" in devset.profiles %}
  "rust-analyzer.check.command": "clippy",
{%- endif %}
{%- if "toml" in devset.profiles %}
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
{%- endif %}
{%- if "markdown" in devset.profiles %}
  "rumdl.fixOnSave": true,
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.markdownFragmentLinks": "ignore",
{%- endif %}
{%- if "dprint" in devset.profiles %}
  "json.schemaDownload.trustedDomains": { "https://plugins.dprint.dev/": true, "https://dprint.dev/": true },
  "[json][jsonc]{% if "markdown" in devset.profiles %}[markdown]{% endif %}{% if "yaml" in devset.profiles %}[yaml]{% endif %}{% if "python" in devset.profiles %}[python]{% endif %}[javascript][css]": { "editor.defaultFormatter": "dprint.dprint" },
{%- endif %}
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true
}
