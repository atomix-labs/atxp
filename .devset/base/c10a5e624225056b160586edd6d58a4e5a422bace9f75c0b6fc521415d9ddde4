# The collection's catalog site: devset-collection writes its pages under src/, from the manifests
# and each profile's README, and checks them; this file is the repository's.
[book]
title       = "atxp"
description = ""
language    = "en"
src         = "src"

[output.html]
default-theme        = "light"
preferred-dark-theme = "navy"
git-repository-url   = "https://github.com/atomix-labs/atxp"
site-url             = "/atxp/"
additional-css       = ["theme/palette.css"]

[output.html.search]
enable = true
